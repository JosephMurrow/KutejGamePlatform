# Боевое окружение. Скопировать в .env рядом с docker-compose.prod.yml.
# С реальными значениями в git не коммитить.

POSTGRES_USER=platitutka
POSTGRES_DB=platitutka
# openssl rand -base64 24
POSTGRES_PASSWORD=

# Секрет подписи сессий, от 32 символов: openssl rand -base64 48
# Менять нельзя без нужды — смена разлогинивает всех разом.
SESSION_SECRET=

# Имя, на которое Caddy выпустит сертификат.
DOMAIN=pricetitute.duckdns.org
# Токен DuckDNS: он один на весь аккаунт, тот же, что у соседних доменов.
DUCKDNS_TOKEN=

# Внешний адрес игры: из него собираются ссылки в письмах.
APP_URL=https://pricetitute.duckdns.org:8443

# Почтовый релей. Свой сервер поднимать не нужно и не стоит: письма с
# домашнего адреса режут на входе. Подойдёт любая служба с SMTP.
#
# ВАЖНО: MAIL_FROM должен совпадать с ящиком из MAIL_USER. Обычные почтовые
# службы не дают отправлять от чужого адреса — письмо просто отклонят. Адрес
# вида no-reply@pricetitute.duckdns.org тут не годится: на поддомене DuckDNS
# нельзя завести записи SPF и DKIM, а без них служба такой отправке не поверит.
#
# Порт: 465 — TLS с первого байта, 587 — STARTTLS. Пароль обычно нужен
# отдельный, «для приложений», а не тот, которым вы входите в почту.
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Платитутка <ваш-ящик@yandex.ру>

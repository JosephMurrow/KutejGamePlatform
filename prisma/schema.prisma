generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// В Prisma 7 строка подключения живёт в prisma.config.ts, а не здесь.
datasource db {
  provider = "postgresql"
}

/// Тематический пак вопроса. Пришёл на смену тональности: режим комнаты
/// набирается из паков, а не из категорий (см. docs/BACKLOG.md F1).
enum QuestionPack {
  /// Нынешние 500: бытовое, социальное и откровенное.
  STANDARD
  /// Пьянка без жести.
  DRUNK
  /// Прямее и подробнее, чем откровенное из «Стандарта».
  SEX
  /// Чужое, подельники, нары.
  CRIME
  /// Самое дно, 21+. Есть ровно в одном режиме и только вручную.
  BLACK
}

/// Набор паков, которым играет комната.
enum QuestionMode {
  /// Стандарт.
  NORMAL
  /// Стандарт, пьянка, секс, криминал.
  DRUNK_PARTY
  /// Пьянка, секс, криминал, чернота. Стандарта нет намеренно.
  HARDCORE
}

/// Вопрос из пула. Задаётся ведущему, тот отвечает суммой (см. docs/SPEC.md §6).
model Question {
  id     String       @id @default(cuid())
  text   String       @unique
  pack   QuestionPack @default(STANDARD)
  /// Взрослое содержимое. В «Обычном» режиме хост может это выключить;
  /// в остальных паках взрослое всё, и галочка там не показывается.
  adult  Boolean      @default(false)
  /// Выключенный вопрос не попадает в новые очереди.
  active Boolean      @default(true)

  createdAt DateTime @default(now())

  rounds Round[]

  @@index([active, pack, adult])
  @@map("questions")
}

/// Сыгранный раунд: что спросили, что ответил ведущий, кто сколько поставил.
model Round {
  id      String @id @default(cuid())
  /// "global" для общей комнаты, иначе идентификатор приватной.
  roomKey String

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  hostId String
  host   User   @relation("HostedRounds", fields: [hostId], references: [id], onDelete: Cascade)

  /// Сумма ведущего в рублях; null, если он выбрал «Ни за какие деньги».
  hostSum   Int?
  hostNever Boolean @default(false)

  finishedAt DateTime

  bets RoundBet[]

  @@index([roomKey, finishedAt])
  @@map("rounds")
}

/// Ставка игрока в раунде.
model RoundBet {
  id String @id @default(cuid())

  roundId String
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  playerId String
  player   User   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  sum   Int?
  never Boolean @default(false)
  /// Взял ли очко за этот раунд.
  won   Boolean @default(false)

  @@unique([roundId, playerId])
  @@map("round_bets")
}

/// Накопленный счёт игрока в конкретной комнате.
/// Очки приватных комнат наружу не идут: они лежат под своим roomKey.
model Score {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roomKey      String
  points       Int    @default(0)
  roundsPlayed Int    @default(0)

  updatedAt DateTime @updatedAt

  @@unique([userId, roomKey])
  @@index([roomKey, points])
  @@map("scores")
}

/// Очередь вопросов конкретной комнаты: порядок сохраняется между
/// перезапусками сервера. Голова очереди — нулевой элемент массива.
model RoomQuestionQueue {
  id           String       @id @default(cuid())
  /// "global" для общей комнаты, иначе идентификатор приватной.
  roomKey      String       @unique
  /// Идентификаторы вопросов в порядке выдачи.
  queue        String[]
  /// Уже выданные в текущем круге: без этого после перезапуска сервера
  /// показанные вопросы вернулись бы в очередь как новые.
  consumed     String[]
  /// Учитываются ли в этой очереди вопросы 18+.
  includeAdult Boolean      @default(true)
  /// Каким режимом собрана очередь: смена режима собирает её заново.
  mode         QuestionMode @default(NORMAL)

  updatedAt DateTime @updatedAt

  @@map("room_question_queues")
}

/// Какого рода комната. От этого зависит, есть ли у неё вид «экран», пускают ли
/// туда гостей и как выглядит приглашение (см. docs/BACKLOG.md Q4).
enum RoomKind {
  /// Своя комната по ссылке: как было до 1.04.
  PRIVATE
  /// Стримерская: код показывают в эфире, вход гостем, экран уходит в трансляцию.
  STREAM
  /// Домашняя: картинка на телевизоре, вход только по аккаунту.
  HOME
}

/// Кто ведёт раунды.
enum HostRotation {
  /// По кругу в порядке входа, как в общем зале.
  CIRCLE
  /// Всегда хозяин комнаты. Круг ходов рассыпается на аудитории: двести
  /// зрителей по шесть минут дают свой ход раз в двадцать часов.
  OWNER
}

/// Чем заканчивается партия в приватной комнате.
enum RoomEndMode {
  /// Играем, пока хост не остановит.
  ENDLESS
  /// До заданного числа раундов.
  ROUNDS
  /// Пока кто-нибудь не наберёт заданное число очков.
  POINTS
}

/// Приватная комната: счёт внутри неё наружу не уходит (см. docs/SPEC.md §3.2).
model PrivateRoom {
  id   String @id @default(cuid())
  /// Короткий код из ссылки-приглашения.
  code String @unique

  hostId String
  host   User   @relation("HostedRooms", fields: [hostId], references: [id], onDelete: Cascade)

  /// Какого рода комната.
  kind      RoomKind @default(PRIVATE)
  /// Название комнаты: рисуется на экране. У обычной приватной пусто.
  title     String?
  /// Ключ вида «экран». Браузерный источник OBS ходит со своей пустой банкой
  /// кук, нашей сессии у него нет, — поэтому экран открывается по ключу в
  /// адресе. Утечка ключа не страшна: на экране нет секретов.
  screenKey String   @unique

  /// Длительность фазы ставок, мс.
  bettingMs     Int          @default(300000)
  /// Сколько показывать вскрышку, мс.
  revealMs      Int          @default(30000)
  includeAdult  Boolean      @default(true)
  mode          QuestionMode @default(NORMAL)
  /// Кто ведёт раунды.
  hostRotation  HostRotation @default(CIRCLE)
  /// Набор закрыт: код висит в эфире, и в какой-то момент новых пускать хватит.
  locked        Boolean      @default(false)
  /// Больше этого числа за стол не сажаем. null — без ограничения.
  maxPlayers    Int?
  /// Канал Твича, чей чат слушает комната. Чтение анонимно, разрешений не
  /// требует — достаточно имени (см. docs/BACKLOG.md P1).
  twitchChannel String?
  endMode       RoomEndMode  @default(ENDLESS)
  /// Сколько раундов или очков до конца партии.
  endValue      Int?

  createdAt  DateTime  @default(now())
  /// Когда комната опустела. Через полчаса после этого её удаляют.
  emptySince DateTime?

  /// Гости этой комнаты. Умирают вместе с ней: каскад уносит и их ставки.
  guests User[] @relation("Guests")

  @@index([emptySince])
  @@map("private_rooms")
}

/// Зачем выдана одноразовая ссылка.
enum LinkPurpose {
  /// Подтверждение адреса почты.
  EMAIL_CONFIRM
  /// Сброс забытого пароля.
  PASSWORD_RESET
}

/// Одноразовая ссылка из письма.
///
/// Хранится хеш, а не сама ссылка: утёкшая таблица не должна давать доступ к
/// аккаунтам. Протухшие подметает уборщик комнат.
model OneTimeLink {
  id String @id @default(cuid())

  /// SHA-256 от ссылки. По нему и ищем.
  tokenHash String      @unique
  purpose   LinkPurpose

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Адрес, на который ушло письмо. Подтверждаем именно его: человек мог
  /// успеть поменять почту в профиле, пока письмо шло.
  email String

  expiresAt DateTime
  /// Когда ссылкой воспользовались. Второй раз не сработает.
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("one_time_links")
}

/// Игрок. Регистрация — логин, пароль и почта,
/// восстановление пароля идёт по письму (см. docs/SPEC.md §2).
model User {
  id           String @id @default(cuid())
  /// Хранится в нижнем регистре: логин уникален без учёта регистра.
  login        String @unique
  passwordHash String

  /// Отображаемое имя, не равно логину.
  nickname String
  /// Индекс картинки из пула аватаров (0..29).
  avatarId Int

  /// Момент подтверждения возраста 18+ при регистрации.
  adultConfirmedAt DateTime?

  /// Почта. Пустая допускается: аккаунты, заведённые до появления писем,
  /// живут как жили, а адрес предлагается прикрепить в профиле.
  email            String?   @unique
  /// Момент подтверждения адреса. Сброс пароля работает только с
  /// подтверждённого: иначе опечатка при регистрации отдаёт аккаунт чужому.
  emailConfirmedAt DateTime?

  /// Сессии, выданные раньше этого момента, недействительны. Сдвигается при
  /// смене пароля: увести аккаунт и остаться в нём после сброса нельзя.
  sessionsValidFrom DateTime?

  /// Бот из режима «Forever alone»: войти под ним нельзя.
  isBot Boolean @default(false)

  /// Гость стримерской комнаты: одноразовый профиль без пароля и без почты.
  /// В общий зал, в рейтинг и в профиль он не ходит, а живёт не дольше своей
  /// комнаты (см. docs/BACKLOG.md O3).
  isGuest     Boolean      @default(false)
  /// Комната, ради которой гость заведён. Больше он никуда не ходит.
  guestRoomId String?
  guestRoom   PrivateRoom? @relation("Guests", fields: [guestRoomId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links        OneTimeLink[]
  hostedRounds Round[]       @relation("HostedRounds")
  hostedRooms  PrivateRoom[] @relation("HostedRooms")
  bets         RoundBet[]
  scores       Score[]

  @@index([guestRoomId])
  @@map("users")
}

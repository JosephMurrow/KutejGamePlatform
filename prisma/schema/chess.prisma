// Схема шахмат: настройки комнат и сыгранные партии. Рейтинг придёт своим
// этапом (src/games/chess/docs/PLAN.md, этап 9).
//
// Ни одной колонки в платформенных таблицах: платформа не знает, какие у игры
// настройки, и хранить их у себя не может (docs/DATABASE.md).
//
// Имена моделей и перечислений начинаются с `Chess` не для красоты: в Prisma
// они глобальны, и схема Postgres их не разводит — `RoomSettings` уже занято
// платитуткой. Таблица при этом зовётся просто `room_settings`, потому что
// лежит в своей схеме.

/// Сколько времени даётся на один ход.
///
/// Часы шахмат здесь — лимит на ход, а не бюджет на всю партию: платформа
/// умеет ровно один дедлайн, и лимит на ход ложится на него без единой правки
/// договора движка (src/games/chess/docs/BACKLOG.md A2).
enum ChessTimeControl {
  /// Десять секунд: пуля.
  SEC_10
  /// Полминуты. Столько же жёстко стоит в общем зале.
  SEC_30
  /// Минута.
  MIN_1
  /// Три минуты.
  MIN_3
  /// Без ограничения — будильник не заводится вовсе.
  UNLIMITED

  @@schema("chess")
}

/// Кто по ту сторону доски.
enum ChessOpponentKind {
  /// Живой человек: комната ждёт второго по ссылке.
  HUMAN
  /// Бот. Уровень и характер появятся вместе с движком (этапы 7 и 8).
  BOT

  @@schema("chess")
}

/// Уровень бота. Четыре видимых; пятый, скрытый, придёт своим этапом.
enum ChessBotLevel {
  EASY
  NORMAL
  HARD
  EXPERT

  @@schema("chess")
}

/// Настройки партии шахмат в конкретной комнате.
///
/// Внешнего ключа на комнату нет намеренно — как и у платитутки, тут обычная
/// строка: ключом бывает литерал общего зала, которому строки в базе нет.
/// Убирает эти строки сама игра, когда платформа сообщает об удалении комнаты
/// (docs/DATABASE.md).
model ChessRoomSettings {
  /// Идентификатор комнаты из platform.private_rooms.
  roomId String @id

  /// Сколько даётся на ход.
  timeControl  ChessTimeControl
  /// Человек по ту сторону или бот.
  opponent     ChessOpponentKind
  /// Режим стримера: подсказки гасит клиент, поэтому флаг лежит на комнате, а
  /// не на человеке (src/games/chess/docs/BACKLOG.md F1).
  streamerMode Boolean     @default(false)
  /// Уровень бота. Значим только когда соперник — бот.
  botLevel     ChessBotLevel @default(NORMAL)

  @@map("room_settings")
  @@schema("chess")
}

/// Чем кончилась партия.
enum ChessResult {
  WHITE
  BLACK
  DRAW

  @@schema("chess")
}

/// Сыгранная партия.
///
/// Хранится списком ходов и временем на каждый, а не позициями: позиции
/// восстанавливаются из ходов, а обратно — нет
/// (src/games/chess/docs/BACKLOG.md G).
///
/// Ники и рейтинги записаны на момент партии. Люди меняют ники и растут в
/// рейтинге, а история партии от этого меняться не должна.
model ChessMatch {
  id String @id @default(cuid())

  /// Комната, где играли. Строкой без внешнего ключа — как и всё, что
  /// ссылается на комнату: ключом бывает литерал общего зала.
  roomKey String

  whiteId String
  white   User   @relation("ChessWhite", fields: [whiteId], references: [id], onDelete: Cascade)
  blackId String
  black   User   @relation("ChessBlack", fields: [blackId], references: [id], onDelete: Cascade)

  /// Ник и рейтинг на момент партии.
  whiteName   String
  blackName   String
  whiteRating Int
  blackRating Int

  /// Ходы записью, по порядку: e4, e5, Nf3…
  moves String[]
  /// Сколько думали над каждым ходом, мс. Длина совпадает с числом ходов.
  times Int[]

  result ChessResult
  /// Причина окончания: мат, флаг, сдача и прочее — как их называет движок.
  reason String

  timeControl ChessTimeControl

  startedAt DateTime
  endedAt   DateTime @default(now())

  @@index([roomKey, endedAt])
  @@index([whiteId])
  @@index([blackId])
  @@map("matches")
  @@schema("chess")
}

/// Дебютный репертуар бота.
///
/// Без книги бот на слабых уровнях ходит крайними пешками и разрушает всю
/// иллюзию первыми же тремя ходами. Стоит дёшево, эффект огромный
/// (src/games/chess/docs/BACKLOG.md D2).
///
/// Ключ — хеш позиции, а не номер хода: одна и та же позиция приходит разными
/// порядками ходов, и по номеру её не найти.
model ChessOpening {
  level ChessBotLevel
  /// Zobrist-хеш позиции, из которой делается ход.
  position String
  /// Ход в координатах: e2e4.
  move String

  @@id([level, position, move])
  @@index([level, position])
  @@map("openings")
  @@schema("chess")
}

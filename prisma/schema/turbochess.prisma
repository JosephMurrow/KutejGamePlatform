// Схема турбо-шахмат: настройки комнат и сыгранные партии.
//
// Ни одной колонки в платформенных таблицах: платформа не знает, какие у игры
// настройки, и хранить их у себя не может (docs/DATABASE.md).
//
// Имена моделей и перечислений начинаются с `Turbo`: в Prisma они глобальны, и
// схема Postgres их не разводит — `RoomSettings` и `ChessRoomSettings` уже
// заняты. Таблица при этом зовётся просто `room_settings`, потому что лежит в
// своей схеме.

/// Режим партии. Выбирается при создании комнаты и по ходу не меняется.
///
/// Порядок и номера — те же, что в src/games/turbochess/docs/MODES.md: по ним
/// на режимы ссылаются план и разговор с хозяином. Новые режимы дописываются
/// в конец.
enum TurboMode {
  /// 1. Одним видом фигур.
  ONE_KIND
  /// 2. Подкрепление.
  REINFORCEMENTS
  /// 3. На уничтожение.
  ANNIHILATION
  /// 4. Мега-шахматы.
  MEGA
  /// 5. Алко-шахматы.
  BOOZE
  /// 6. Пацанские шахматы.
  NO_RETREAT
  /// 7. Последний шанс.
  LAST_CHANCE
  /// 8. Ядерные шахматы.
  NUCLEAR
  /// 9. Королевская битва: доска 16×16, четверо за столом.
  BATTLE_ROYALE
  /// 10. Двойной агент.
  DOUBLE_AGENT
  /// 11. Поддавки.
  GIVEAWAY
  /// 12. Загул.
  BINGE
  /// 13. Чёрный рынок.
  BLACK_MARKET
  /// 14. Зомби-шахматы.
  ZOMBIE
  /// 15. Анархия в Соединённом Королевстве.
  ANARCHY
  /// 16. Вскрываемся.
  SHOWDOWN
  /// Классика: обычные шахматы. Служебный — игрокам не показывается, нужен
  /// смоуку и тестам: правила остальных режимов меняются на их этапах, а
  /// проверка партии через сервер должна от этого не зависеть.
  CLASSIC

  @@schema("turbochess")
}

/// Сколько времени даётся на один ход — как у шахмат: лимит на ход, а не
/// бюджет на партию.
enum TurboTimeControl {
  SEC_10
  SEC_30
  MIN_1
  MIN_3
  UNLIMITED

  @@schema("turbochess")
}

/// Уровень соперника-программы. Четыре, и сила режется глубиной перебора и
/// вероятностью зевка: узлы были ручкой Стокфиша, а перебор у нас свой
/// (src/games/turbochess/docs/BOTS.md).
enum TurboBotLevel {
  /// Смотрит только на свой ход.
  EASY
  /// Видит ответ.
  NORMAL
  /// То же, но почти не ошибается.
  HARD
  /// Видит ответ на ответ, знает чужие секреты и водит альянсы в битве.
  EXPERT

  @@schema("turbochess")
}

/// Настройки партии в приватной комнате. Общего зала у игры нет.
model TurboRoomSettings {
  /// Строкой без внешнего ключа — так на комнату ссылаются все игры
  /// (docs/DATABASE.md).
  roomId      String           @id
  mode        TurboMode
  timeControl TurboTimeControl @default(SEC_30)
  /// Ручки режима: вид фигур у одновидовых, порог заряда у ядерных и так
  /// далее. Одним полем, а не колонкой на ручку: режимов шестнадцать, и
  /// миграция живой базы на каждую ручку стоила бы дороже, чем проверка формы
  /// в коде. Разбирает и сверяет их src/games/turbochess/rooms/settings.ts.
  options     Json             @default("{}")
  /// Сколько ботов сажать за стол: ноль — ждём живых. Больше одного бывает в
  /// королевской битве, где мест четыре; последнее место всегда остаётся
  /// человеку (src/games/turbochess/docs/BOTS.md, А6 и А8).
  bots        Int              @default(0)
  /// Уровень всех ботов этой комнаты: человек выбирает его один раз, а
  /// различать ботов будут характеры.
  botLevel    TurboBotLevel    @default(NORMAL)

  @@map("room_settings")
  @@schema("turbochess")
}

/// Сыгранная партия.
///
/// Хранится не позициями, а тем, из чего позиции восстанавливаются: режимом,
/// его ручками, зерном случайности и ходами. Зерно — ради режимов, где
/// бросают кости: второй прогон тех же ходов с тем же зерном даст ту же
/// партию (src/games/turbochess/docs/BACKLOG.md C3).
model TurboMatch {
  /// Постоянный на всю партию: по нему запись обновляется, а не плодится.
  id          String           @id
  /// Строкой без внешнего ключа — так на комнату ссылаются все игры.
  roomKey     String
  mode        TurboMode
  options     Json             @default("{}")
  /// Зерно генератора случайных чисел партии.
  seed        Int
  timeControl TurboTimeControl
  /// Ходы записью, по порядку.
  moves       String[]
  /// Сколько думали над каждым ходом, мс.
  times       Int[]
  /// Место победителя; `null` — ничья.
  winner      Int?
  /// Почему кончилась (src/games/turbochess/engine/outcome.ts).
  reason      String
  /// Кто из сидевших был программой: место, характер, уровень и ник. Отдельным
  /// полем, а не строкой в `match_seats`: там у места внешний ключ на живого
  /// пользователя, а у бота учётной записи нет и быть не должно.
  bots        Json             @default("[]")
  startedAt   DateTime
  endedAt     DateTime
  seats       TurboMatchSeat[]

  @@index([roomKey, endedAt])
  @@map("matches")
  @@schema("turbochess")
}

/// Кто сидел за столом. Отдельной таблицей, а не парой колонок «белые —
/// чёрные»: в королевской битве мест четыре (docs/MODES.md, режим 9).
model TurboMatchSeat {
  matchId String
  /// Место за столом, с нуля: у двоих это белые и чёрные.
  seat    Int
  userId  String
  /// Ник на момент партии: человек его сменит, а история меняться не должна.
  name    String
  match   TurboMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user    User       @relation("TurboSeats", fields: [userId], references: [id], onDelete: Cascade)

  @@id([matchId, seat])
  @@index([userId])
  @@map("match_seats")
  @@schema("turbochess")
}

// Схема турбо-шахмат: пока одни настройки комнаты.
//
// Ни одной колонки в платформенных таблицах: платформа не знает, какие у игры
// настройки, и хранить их у себя не может (docs/DATABASE.md).
//
// Имена моделей и перечислений начинаются с `Turbo`: в Prisma они глобальны, и
// схема Postgres их не разводит — `RoomSettings` и `ChessRoomSettings` уже
// заняты. Таблица при этом зовётся просто `room_settings`, потому что лежит в
// своей схеме.

/// Режим партии. Выбирается при создании комнаты и по ходу не меняется.
///
/// Порядок и номера — те же, что в src/games/turbochess/docs/MODES.md: по ним
/// на режимы ссылаются план и разговор с хозяином. Новые режимы дописываются
/// в конец.
enum TurboMode {
  /// 1. Одним видом фигур.
  ONE_KIND
  /// 2. Подкрепление.
  REINFORCEMENTS
  /// 3. На уничтожение.
  ANNIHILATION
  /// 4. Мега-шахматы.
  MEGA
  /// 5. Алко-шахматы.
  BOOZE
  /// 6. Пацанские шахматы.
  NO_RETREAT
  /// 7. Последний шанс.
  LAST_CHANCE
  /// 8. Ядерные шахматы.
  NUCLEAR
  /// 9. Королевская битва: доска 16×16, четверо за столом.
  BATTLE_ROYALE
  /// 10. Двойной агент.
  DOUBLE_AGENT
  /// 11. Поддавки.
  GIVEAWAY
  /// 12. Загул.
  BINGE
  /// 13. Чёрный рынок.
  BLACK_MARKET
  /// 14. Зомби-шахматы.
  ZOMBIE
  /// 15. Анархия в Соединённом Королевстве.
  ANARCHY
  /// 16. Вскрываемся.
  SHOWDOWN

  @@schema("turbochess")
}

/// Настройки партии в приватной комнате. Общего зала у игры нет.
model TurboRoomSettings {
  /// Строкой без внешнего ключа — так на комнату ссылаются все игры
  /// (docs/DATABASE.md).
  roomId  String    @id
  mode    TurboMode
  /// Ручки режима: вид фигур у одновидовых, порог заряда у ядерных и так
  /// далее. Одним полем, а не колонкой на ручку: режимов шестнадцать, и
  /// миграция живой базы на каждую ручку стоила бы дороже, чем проверка формы
  /// в коде. Разбирает и сверяет их src/games/turbochess/rooms/settings.ts.
  options Json      @default("{}")

  @@map("room_settings")
  @@schema("turbochess")
}

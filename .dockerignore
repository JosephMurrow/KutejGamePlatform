# Скрипты обслуживания базы нужны в образе: они запускаются в том же
# контейнере (db:rename-questions и подобные). Смоук-тесты и бот-напарник —
# не нужны. Игровые скрипты и документы переехали к игре, поэтому пути с
# именем игры: docs исключаются и здесь тоже, чтобы образ не тащил бэклоги.
scripts/smoke-*.ts
src/games/*/scripts/bot-player.ts
src/games/*/docs

.env
.env.*
!.env.example
src/generated
*.log

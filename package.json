{
  "name": "pricetitute",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server.ts",
    "build": "next build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import tsx server.ts",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "smoke:sockets": "node --env-file-if-exists=.env --import tsx scripts/smoke-sockets.ts",
    "smoke:crowd": "node --env-file-if-exists=.env --import tsx scripts/smoke-crowd.ts",
    "bot": "node --env-file-if-exists=.env --import tsx scripts/bot-player.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "audit:questions": "node --import tsx scripts/audit-questions.ts",
    "db:rename-questions": "node --env-file-if-exists=.env --import tsx scripts/rename-questions.ts",
    "mail:check": "node --env-file-if-exists=.env --import tsx scripts/mail-check.ts",
    "twitch:check": "node --import tsx scripts/twitch-check.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "jose": "^6.2.8",
    "next": "16.3.1",
    "nodemailer": "^9.0.5",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "jsqr": "^1.4.0",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

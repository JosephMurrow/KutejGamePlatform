# Скопируй в .env и при необходимости поправь.
# Значения ниже совпадают с docker-compose.yml и годятся для локальной разработки.

DATABASE_URL="postgresql://pricetitute:pricetitute@localhost:5432/pricetitute?schema=public"

HOST=localhost
PORT=3000

# Секрет для подписи сессионных cookie. Минимум 32 символа.
# Сгенерировать: openssl rand -base64 48
SESSION_SECRET="замени-меня-на-случайную-строку-минимум-32-символа"

# Внешний адрес игры. Из него собираются ссылки в письмах.
APP_URL="http://localhost:3000"

# Почта. Значения ниже — для песочницы из docker-compose.yml:
# письма никуда не уходят и видны на http://localhost:8025
MAIL_HOST="localhost"
MAIL_PORT=1025
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_FROM="Кутёж <no-reply@pricetitute.local>"

# Движок шахмат: отдельный процесс, в бандл не попадает. Пусто — ботов нет.
CHESS_ENGINE_PATH=
